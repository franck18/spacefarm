            "group_wait": "30s",
            "group_interval": "5m",
            "repeat_interval": "4h"
          },
          "annotations": {
            "summary": "Température hors de la plage 18–30 °C depuis cinq minutes."
          }
        },
        {
          "uid": "spacefarm-sensor-missing",
          "title": "SpaceFarm · Mesure indisponible",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "spacefarm-api",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
