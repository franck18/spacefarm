                "url_options": {
                  "method": "GET"
                },
                "root_selector": "[{value: ([.measurements.temperature.value, .measurements.humidity.value, .measurements.light.value, .measurements.water.value] | if any(. == null) then 1 else 0 end)}]",
                "format": "table",
                "columns": [
                  {
                    "selector": "value",
                    "text": "value",
                    "type": "number"
                  }
                ],
                "datasource": {
                  "type": "yesoreyeram-infinity-datasource",
                  "uid": "spacefarm-api"
                },
                "intervalMs": 60000,
                "maxDataPoints": 1
