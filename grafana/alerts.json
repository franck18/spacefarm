                      "type": "gt",
                      "params": [
                        0.5
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
              }
            }
          ],
          "for": "5m",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "isPaused": false,
          "labels": {
            "project": "spacefarm"
          },
          "notification_settings": {
            "receiver": "SpaceFarm e-mail",
            "group_by": [
              "grafana_folder",
              "alertname"
